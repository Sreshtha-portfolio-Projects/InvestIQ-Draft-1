# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# AI - OpenRouter.ai (get key from https://openrouter.ai/keys)
OPENROUTER_API_KEY=your-openrouter-api-key-here
# Default model is openrouter/free (zero-cost router). Override with any model id, e.g. google/gemma-3-4b-it:free
# AI_MODEL=openrouter/free
# Max completion tokens per request (default 1024). Raise only if responses truncate.
# AI_MAX_TOKENS=1024

# Market Data
FINNHUB_API_KEY=your-finnhub-api-key-here
