# Production Environment Variables for Docker Compose (IP-only mode)
# Copy this file to .env and fill in your actual values

# Frontend URL (use your Oracle VPS public IP; no trailing slash)
FRONTEND_URL=http://YOUR_VPS_PUBLIC_IP

# Backend API URL (must match VPS IP + /api)
NEXT_PUBLIC_API_URL=http://YOUR_VPS_PUBLIC_IP/api

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# API Keys
GEMINI_API_KEY=your-gemini-api-key-here
FINNHUB_API_KEY=your-finnhub-api-key-here
